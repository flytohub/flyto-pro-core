# Flyto2 Pro Core configuration example.
# Copy only the values your integration uses; never commit real secrets.

# Runtime
# Runtime environment label.
FLYTO_ENV=development
# Enable debug behavior.
DEBUG=false

# PostgreSQL
# Database host.
POSTGRES_HOST=localhost
# Database port.
POSTGRES_PORT=5432
# Database name.
POSTGRES_DB=flyto_jobs
# Database user.
POSTGRES_USER=postgres
# Database password. (secret; leave blank in source control)
POSTGRES_PASSWORD=
# PostgreSQL SSL mode.
POSTGRES_SSL_MODE=require

# Redis
# Redis host.
REDIS_HOST=localhost
# Redis port.
REDIS_PORT=6379
# Redis password. (secret; leave blank in source control)
REDIS_PASSWORD=
# Redis database number.
REDIS_DB=0

# Qdrant
# Remote Qdrant URL; blank keeps it unavailable.
QDRANT_URL=
# Qdrant API key. (secret; leave blank in source control)
QDRANT_API_KEY=
# Default collection.
QDRANT_COLLECTION=flyto_knowledge
# Local Qdrant path.
QDRANT_PATH=./qdrant_storage

# Ollama
# Ollama base URL.
OLLAMA_URL=http://localhost:11434
# Chat model.
OLLAMA_MODEL=llama3.2:latest
# Embedding model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI
# OpenAI API key. (secret; leave blank in source control)
OPENAI_API_KEY=
# Default OpenAI model.
OPENAI_MODEL=gpt-4o-mini
# Fast-task model override.
OPENAI_FAST_MODEL=gpt-4o-mini
# Complex-task model override.
OPENAI_SMART_MODEL=gpt-4o
# Embedding model override.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
# Anthropic API key. (secret; leave blank in source control)
ANTHROPIC_API_KEY=
# Anthropic model.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Telegram
# Telegram bot token. (secret; leave blank in source control)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs.
TELEGRAM_ALLOWED_USERS=

# API
# API bind host.
API_HOST=0.0.0.0
# API bind port.
API_PORT=8000
# API worker count.
API_WORKERS=1
# Enable API debug behavior.
API_DEBUG=false

# License
# License service URL.
LICENSE_SERVER_URL=https://license.flyto2.com/api/v1
# Local license-cache directory.
LICENSE_CACHE_DIR=.flyto2/license

# Timeouts
# Default HTTP timeout in seconds.
TIMEOUT_HTTP=30
# Telegram timeout in seconds.
TIMEOUT_TELEGRAM=10
# GitHub timeout in seconds.
TIMEOUT_GITHUB=30
# OpenAI timeout in seconds.
TIMEOUT_OPENAI=60
# Anthropic timeout in seconds.
TIMEOUT_ANTHROPIC=120
# Qdrant timeout in seconds.
TIMEOUT_QDRANT=30
# Ollama timeout in seconds.
TIMEOUT_OLLAMA=120
# Docker readiness timeout in seconds.
TIMEOUT_DOCKER=180
# Subprocess timeout in seconds.
TIMEOUT_SUBPROCESS=60
# File-operation timeout in seconds.
TIMEOUT_FILE=30
# Git-operation timeout in seconds.
TIMEOUT_GIT=60

# Agent budget
# Maximum estimated USD cost.
AGENT_BUDGET_MAX_COST_USD=1.0
# Maximum token count.
AGENT_BUDGET_MAX_TOKENS=100000
# Maximum tool calls.
AGENT_BUDGET_MAX_TOOL_CALLS=50
# Maximum LLM calls.
AGENT_BUDGET_MAX_LLM_CALLS=30
# Maximum agent iterations.
AGENT_BUDGET_MAX_ITERATIONS=20
# Maximum runtime in seconds.
AGENT_BUDGET_MAX_RUNTIME_SECONDS=300
# Fraction that triggers warnings.
AGENT_BUDGET_WARNING_THRESHOLD=0.8

# Tier budgets
# Free-tier USD limit.
BUDGET_FREE_MAX_COST=0.1
# Free-tier token limit.
BUDGET_FREE_MAX_TOKENS=10000
# Free-tier tool-call limit.
BUDGET_FREE_MAX_TOOLS=10
# Free-tier LLM-call limit.
BUDGET_FREE_MAX_LLM=5
# Free-tier iteration limit.
BUDGET_FREE_MAX_ITER=5
# Pro-tier USD limit.
BUDGET_PRO_MAX_COST=1.0
# Pro-tier token limit.
BUDGET_PRO_MAX_TOKENS=100000
# Pro-tier tool-call limit.
BUDGET_PRO_MAX_TOOLS=50
# Pro-tier LLM-call limit.
BUDGET_PRO_MAX_LLM=30
# Pro-tier iteration limit.
BUDGET_PRO_MAX_ITER=20
# Enterprise-tier USD limit.
BUDGET_ENTERPRISE_MAX_COST=10.0
# Enterprise-tier token limit.
BUDGET_ENTERPRISE_MAX_TOKENS=500000
# Enterprise-tier tool-call limit.
BUDGET_ENTERPRISE_MAX_TOOLS=200
# Enterprise-tier LLM-call limit.
BUDGET_ENTERPRISE_MAX_LLM=100
# Enterprise-tier iteration limit.
BUDGET_ENTERPRISE_MAX_ITER=50

# Pricing
# JSON model-pricing map.
LLM_PRICING_CONFIG=
# Fallback prompt cost per 1K tokens.
LLM_DEFAULT_PROMPT_COST=0.01
# Fallback completion cost per 1K tokens.
LLM_DEFAULT_COMPLETION_COST=0.03

# Integration scripts
# Local engine URL used by test_closed_loop.py.
FLYTO_API_BASE=https://localhost:3000
# Seed-bank checkout used by test_zapier_convert.py.
FLYTO_PRO_REPO=../flyto-pro
